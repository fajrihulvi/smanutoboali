#--------------------------------------------------------------------------
# APP — identitas aplikasi, locale, dan zona waktu
#--------------------------------------------------------------------------
APP_NAME=Skoolia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

#--------------------------------------------------------------------------
# LOG
#--------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# DB — MySQL/MariaDB (cPanel). Lokal XAMPP: host 127.0.0.1, user root.
#--------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skoolia
DB_USERNAME=root
DB_PASSWORD=

#--------------------------------------------------------------------------
# SESSION, CACHE, QUEUE — semuanya driver database (shared hosting,
# tanpa Redis/supervisor). Queue diproses scheduler lewat cron.
#--------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

#--------------------------------------------------------------------------
# UPLOAD — ukuran maksimum default (KB); dapat diubah di Pengaturan Sekolah
#--------------------------------------------------------------------------
UPLOAD_MAX_SIZE_KB=5120

#--------------------------------------------------------------------------
# MAIL — SMTP cPanel atau layanan transaksional
#--------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@skoolia.test"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# PUSHER — realtime (cluster ap1). Aktif mulai S19; sementara log.
#--------------------------------------------------------------------------
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_SCHEME=https
PUSHER_PORT=443

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

#--------------------------------------------------------------------------
# MIDTRANS — payment gateway (dipakai mulai S25)
#--------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
