includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/
    tmpDir: storage/framework/cache/phpstan
    ignoreErrors:
        # Trait infrastruktur (mis. ChecksStudentOwnership) boleh ada sebelum dipakai Policy modul.
        - identifier: trait.unused
          reportUnmatched: false
