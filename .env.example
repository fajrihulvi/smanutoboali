#--------------------------------------------------------------------------
# APP — identitas aplikasi, locale, dan zona waktu
#--------------------------------------------------------------------------
APP_NAME="SMA NU Toboali"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
# APP_VERSION= (kosongkan: versi dibaca dari file VERSION hasil scripts/build-release.sh)
# Produksi di balik SSL/proxy: APP_FORCE_HTTPS=true, TRUSTED_PROXIES=* (atau IP proxy)
APP_FORCE_HTTPS=false
TRUSTED_PROXIES=
# Token untuk GET /health (kosong = endpoint mati). Buat: php -r "echo bin2hex(random_bytes(24));"
HEALTH_TOKEN=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

#--------------------------------------------------------------------------
# LOG
#--------------------------------------------------------------------------
LOG_CHANNEL=stack
# Produksi: daily (retensi LOG_DAILY_DAYS). Log khusus payment & auth ada di storage/logs.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_PAYMENT_DAYS=30
LOG_AUTH_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# DB — MySQL/MariaDB (cPanel). Lokal XAMPP: host 127.0.0.1, user root.
#--------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skoolia
DB_USERNAME=root
DB_PASSWORD=

#--------------------------------------------------------------------------
# SESSION, CACHE, QUEUE — semuanya driver database (shared hosting,
# tanpa Redis/supervisor). Queue diproses scheduler lewat cron.
#--------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

#--------------------------------------------------------------------------
# UPLOAD — ukuran maksimum default (KB); dapat diubah di Pengaturan Sekolah
#--------------------------------------------------------------------------
UPLOAD_MAX_SIZE_KB=5120

#--------------------------------------------------------------------------
# MAIL — SMTP cPanel atau layanan transaksional
#--------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@skoolia.test"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# PUSHER — realtime (cluster ap1). Tanpa PUSHER_APP_KEY, broadcaster otomatis turun ke `log`
# (AppServiceProvider) dan UI memakai fallback muat ulang saat fokus.
#--------------------------------------------------------------------------
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_SCHEME=https
PUSHER_PORT=443

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

#--------------------------------------------------------------------------
# MIDTRANS — payment gateway (S25). Kosongkan untuk menonaktifkan pembayaran online.
# URL notifikasi di dashboard Midtrans: https://<domain>/webhooks/midtrans
#--------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Keamanan HTTP (S32)
CSP_ENABLED=true
CSP_REPORT_ONLY=false
HSTS_ENABLED=true

# Laporan (S31): di atas jumlah baris ini ekspor diproses antrean
REPORT_DIRECT_LIMIT=300

# Backup (S34) — php artisan skoolia:backup database|files|clean
BACKUP_NAME=skoolia
BACKUP_DISKS=backups
BACKUP_MAIL_TO=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAX_MB=5000
# Folder berisi binary mysqldump bila tidak ada di PATH (mis. /usr/bin)
DB_DUMP_BINARY_PATH=

# Pemasangan awal produksi (S35) — dibaca sekali oleh `php artisan db:seed --force`.
# Nilai berspasi wajib diberi tanda kutip. Hapus DEFAULT_ACCOUNT_PASSWORD setelah seeding.
SCHOOL_NAME="SMA NU Toboali"
SCHOOL_LEVEL=SMA
# Akun default: operator@, kepsek@, guru@, ortu@<ACCOUNT_DOMAIN>, wajib ganti password saat login pertama.
ACCOUNT_DOMAIN=smanutoboali.sch.id
# Min 12 karakter, huruf besar & kecil, angka, simbol, dan tidak ada di daftar kebocoran publik.
DEFAULT_ACCOUNT_PASSWORD=
