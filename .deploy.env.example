# Konfigurasi scripts/deploy-hosting.sh — salin ke .deploy.env (tidak di-commit) lalu sesuaikan.

# Alias Host di ~/.ssh/config (lihat docs/DEPLOY_HOSTINGER.md §2).
DEPLOY_SSH=hostinger

# Folder aplikasi di server, relatif ke home. Hostinger/Niagahoster hPanel:
#   domains/<domain>/smanutoboali      (public_html = symlink ke smanutoboali/public)
# cPanel lama: smanutoboali
DEPLOY_PATH=domains/smanutoboali.sch.id/smanutoboali

DEPLOY_BRANCH=main

# PHP 8.2+ dan Composer 2 di server. Cek dengan `php -v` lewat SSH; bila versi lama,
# pakai path lengkap, mis. /opt/alt/php83/usr/bin/php
DEPLOY_PHP=php
DEPLOY_COMPOSER=composer
